# TradingView Screenshot Tool - Environment Configuration
# Copy this file to .env and update the values

# Root password for SSH access (CHANGE THIS!)
ROOT_PASSWORD=your_secure_password_here

# Container timezone
TZ=Europe/Berlin

# API Key Configuration
# Create a key.md file on the host with your API key:
#   echo "YourSecretAPIKey" > /home/pi/tradingview-screenshot/key.md
# This file is mounted read-only into the container at /app/key.md
